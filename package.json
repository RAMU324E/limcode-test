{
  "name": "limcode-test",
  "displayName": "Limcode test",
  "description": "VS Code extension with a TypeScript ECS backend, Vue webview frontend, and a basic AI chat flow.",
  "version": "0.0.8",
  "publisher": "your-publisher",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/lurenxing628/limcode2.git"
  },
  "engines": {
    "vscode": "^1.89.0"
  },
  "extensionKind": [
    "workspace"
  ],
  "categories": [
    "Other"
  ],
  "main": "./dist/extension/vscode/extension.js",
  "activationEvents": [
    "onCommand:limcode-test.openPanel",
    "onCommand:limcode-test.revealGlobalStorage",
    "onCommand:limcode-test.inspectReliability",
    "onCommand:limcode-test.resetDevelopmentData",
    "onView:limcode-test-entry-view",
    "onWebviewPanel:limcode-test.mainPanel"
  ],
  "contributes": {
    "commands": [
      {
        "command": "limcode-test.openPanel",
        "title": "Limcode test: Open AI Chat",
        "category": "Limcode test"
      },
      {
        "command": "limcode-test.revealGlobalStorage",
        "title": "Limcode test: Reveal Data Storage Folder",
        "category": "Limcode test"
      },
      {
        "command": "limcode-test.inspectReliability",
        "title": "Limcode test: Inspect Reliability State (Development)",
        "category": "Limcode test"
      },
      {
        "command": "limcode-test.resetDevelopmentData",
        "title": "Limcode test: Archive and Reset Development Data",
        "category": "Limcode test"
      }
    ],
    "keybindings": [
      {
        "command": "limcode-test.applyLiveDiffPreview",
        "key": "ctrl+s",
        "mac": "cmd+s",
        "when": "resourceScheme == 'limcode-test-live-diff'"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "limcode-test-sidebar",
          "title": "LIMCODE TEST",
          "icon": "assets/icons/activity-bar.svg"
        }
      ]
    },
    "views": {
      "limcode-test-sidebar": [
        {
          "id": "limcode-test-entry-view",
          "name": "",
          "type": "webview",
          "icon": "assets/icons/activity-bar.svg"
        }
      ]
    },
    "configurationDefaults": {
      "workbench.editor.tabSizing": "fixed",
      "workbench.editor.tabSizingFixedMinWidth": 160,
      "workbench.editor.tabSizingFixedMaxWidth": 160
    }
  },
  "scripts": {
    "clean:extension": "node -e \"require('fs').rmSync('dist/extension',{recursive:true,force:true})\"",
    "generate:cutover-manifest": "node scripts/reliable-kernel/generate-physical-cutover-manifest.mjs",
    "check:cutover-manifest": "node scripts/reliable-kernel/generate-physical-cutover-manifest.mjs --check",
    "compile": "npm run check:cutover-manifest && npm run clean:extension && tsc -p tsconfig.json && node scripts/reliable-kernel/write-compile-provenance.mjs",
    "watch": "tsc -watch -p tsconfig.json",
    "build:webview": "vite build",
    "dev:webview": "vite --host 127.0.0.1 --port 31820 --strictPort",
    "build": "npm run compile && npm run build:webview && node scripts/reliable-kernel/write-build-provenance.mjs",
    "typecheck:webview": "vue-tsc -p tsconfig.webview.json --noEmit",
    "check": "npm run check:plan",
    "check:contracts:plan": "node scripts/reliable-kernel/check-plan.mjs",
    "check:package:surface": "node scripts/reliable-kernel/check-package-surface.mjs",
    "check:plan": "npm run build && npm run typecheck:webview && npm run check:contracts:plan",
    "check:plan:tracked": "npm run build && npm run typecheck:webview && node scripts/reliable-kernel/check-plan.mjs --require-tracked",
    "check:gate": "node scripts/reliable-kernel/check-stage-gate.mjs",
    "check:foundation": "npm run compile && node scripts/reliable-kernel/validators/foundation.mjs",
    "test:foundation": "npm run compile && node --test tests/reliable-kernel/phase-b-foundation.test.mjs",
    "test:phase-c": "npm run compile && node --test tests/reliable-kernel/phase-c-turn-control-plane.test.mjs",
    "test:phase-d": "npm run compile && node --test tests/reliable-kernel/phase-d-effects-tools-files-processes.test.mjs",
    "test:phase-e": "npm run compile && node --test tests/reliable-kernel/phase-e-context-provider.test.mjs",
    "test:phase-f": "npm run compile && node --test tests/reliable-kernel/phase-f-subagent-client.test.mjs",
    "check:phase-d": "npm run compile && node --test tests/reliable-kernel/phase-c-turn-control-plane.test.mjs tests/reliable-kernel/phase-d-effects-tools-files-processes.test.mjs",
    "check:candidate": "npm run compile && node scripts/reliable-kernel/validators/candidate.mjs",
    "smoke:sqlite:host": "node scripts/reliable-kernel/sqlite-extension-host-smoke.mjs",
    "rebuild:sqlite:electron": "node scripts/reliable-kernel/rebuild-sqlite-electron.mjs",
    "check:local": "npm run check:plan && node scripts/reliable-kernel/run-local-tests.mjs",
    "vscode:prepublish": "npm run build && node scripts/reliable-kernel/prune-package-dist.mjs",
    "package:local": "vsce package --allow-missing-repository"
  },
  "devDependencies": {
    "@electron/rebuild": "4.2.0",
    "@tabler/icons-vue": "^3.44.0",
    "@types/better-sqlite3": "7.6.13",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^20.14.10",
    "@types/vscode": "^1.89.0",
    "@types/ws": "8.18.1",
    "@vitejs/plugin-vue": "^5.0.5",
    "@vscode/vsce": "^3.7.1",
    "katex": "^0.17.0",
    "markdown-it": "^14.2.0",
    "markdown-it-texmath": "^1.0.0",
    "pinia": "^2.3.1",
    "typescript": "^5.5.3",
    "vite": "^5.3.3",
    "vue": "^3.4.31",
    "vue-tsc": "^2.0.26"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "better-sqlite3": "13.0.2",
    "https-proxy-agent": "7.0.6",
    "tokenx": "^1.3.0",
    "undici": "^6.26.0",
    "unified-llm-provider": "0.1.29",
    "ws": "8.21.1",
    "zod": "4.4.3"
  }
}
